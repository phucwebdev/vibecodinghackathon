# Sao chép file này thành .env rồi điền key. KHÔNG commit .env lên GitHub.

# Thứ tự thử: provider đầu lỗi → tự chuyển sang provider sau
AI_ORDER=claude,deepseek,gemini

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Bắt buộc nếu key dạng sk-ant-usr-... (lấy ở console.anthropic.com → Settings → Workspaces, dạng wrkspc_...)
CLAUDE_WORKSPACE_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Thời gian chờ mỗi provider và tổng thời gian tối đa cho 1 yêu cầu (ms)
AI_TIMEOUT_MS=20000
AI_TOTAL_BUDGET_MS=45000
AI_MAX_TOKENS=1024

# System prompt mặc định (để trống nếu không cần)
AI_SYSTEM_PROMPT=Bạn là trợ lý AI, luôn trả lời bằng tiếng Việt, ngắn gọn và chính xác.

# Domain frontend được phép gọi API (cách nhau bởi dấu phẩy). * = cho phép tất cả
CORS_ORIGIN=*

PORT=3001
